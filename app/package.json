{
  "name": "briefsip",
  "version": "0.10.26",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.hub.config.ts",
    "start": "node --experimental-strip-types server.ts",
    "hub": "node --experimental-strip-types hub/server.ts",
    "test": "node scripts/test.mjs",
    "test:phase-0": "node ../work/rebuild/collaboration-check/t3-provenance.mjs --phase --receipt ../work/rebuild/collaboration-check/phase-0.json",
    "test:phase-1": "node ../work/rebuild/collaboration-check/phase.mjs 1",
    "test:phase-2": "node --experimental-strip-types ../work/rebuild/collaboration-check/two-process.mjs --phase --receipt ../work/rebuild/collaboration-check/phase-2.json",
    "test:phase-3": "node ../work/rebuild/collaboration-check/phase.mjs 3",
    "cli": "node --experimental-strip-types cli.ts",
    "telegram": "node --experimental-strip-types telegram-runner.ts",
    "slack": "node --experimental-strip-types slack-runner.ts",
    "skills": "node --experimental-strip-types skill-directory.ts",
    "lint": "eslint . --max-warnings 0 && node lint/check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@clerk/backend": "3.27.0",
    "@clerk/react": "6.18.6",
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "1.3.0",
    "@novnc/novnc": "1.7.0",
    "entities": "8.1.0",
    "get-nonce": "1.0.1",
    "lucide-react": "1.61.0",
    "marked": "18.2.0",
    "radix-ui": "1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "ws": "8.23.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "^7.3.8"
  }
}
